# Local-only staging test environment. Copy this file to .env.test.local and fill it
# from the approved staging secret source. Never use production credentials here.
# This file is intentionally ignored by Git.
SUPABASE_URL=                 # staging https://<20-char-ref>.supabase.co
SUPABASE_ACCESS_TOKEN=        # staging Management API token
SUPABASE_SECRET_KEY=          # staging server/service key
TEST_SUPABASE_PROJECT_REF=    # must match the ref in SUPABASE_URL

# Read-only member and optional CRUD browser flows.
AUTH_SECRET=
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Local-only targets. The runner rejects Preview/Production URLs.
E2E_BASE_URL=http://127.0.0.1:3000
PAYMENTS_PREVIEW_URL=http://127.0.0.1:3000

# Optional vendor key. Tracking tests normally mock the vendor and do not need it.
SWEETTRACKER_API_KEY=

# Do not set E2E_ADMIN_CRUD here. Pass --allow-staging-writes explicitly when needed.
